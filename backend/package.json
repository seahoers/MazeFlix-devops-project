{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck:ci": "tsc --noEmit",
    "test": "bun test --watch",
    "test:ci": "bun test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.36.4",
    "express": "^5.0.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "supertest": "^7.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.36.0"
  }
}
