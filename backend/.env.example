DATABASE_URL=postgresql://mazeflix:mazeflix@localhost:5433/mazeflix
PORT=3000
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# The test suite (bun test) truncates tables between tests, so it refuses to
# run unless DATABASE_URL points at a database whose name ends in "_test" —
# never point it at the database above. Create one once:
#   createdb -h localhost -p 5433 -U mazeflix mazeflix_test
# then run tests with, e.g.:
#   DATABASE_URL=postgresql://mazeflix:mazeflix@localhost:5433/mazeflix_test bun test
